---
// Card de serviço reutilizado em Desenvolvimento e em Suporte de TI.
// estilo="destaque": ícone em quadrado azul (Desenvolvimento)
// estilo="simples":  ícone solto + etiquetas NO LOCAL/BANCADA (Suporte)
import Icon from './Icon.astro';
import { wa } from '../data/site';
import type { Servico } from '../data/servicos';

interface Props {
  servico: Servico;
  estilo?: 'destaque' | 'simples';
  textoCta?: string;
}
const { servico, estilo = 'simples', textoCta = 'Orçamento grátis' } = Astro.props;
---
<article class:list={['card', `servico--${estilo}`]}>
  {estilo === 'destaque'
    ? <span class="servico__icone-box"><Icon name={servico.icone} size={24} /></span>
    : <Icon name={servico.icone} size={28} class="servico__icone" />}

  <h3>{servico.titulo}</h3>
  <p>{servico.texto}</p>

  {servico.modalidades && (
    <ul class="servico__modalidades" aria-label="Onde o serviço é feito">
      {servico.modalidades.map((m) => <li>{m}</li>)}
    </ul>
  )}

  <a class="card-cta" href={wa(servico.mensagem)} target="_blank" rel="noopener">
    <span>{textoCta}<span class="sr-only"> de {servico.titulo.toLowerCase()} pelo WhatsApp</span></span>
    <span class="card-cta__icone"><Icon name="seta" size={18} stroke={2} /></span>
  </a>
</article>

<style>
  .servico--destaque { padding: 28px; gap: 16px; }
  .servico--destaque h3 { font-size: 21px; }
  .servico--destaque p { font-size: 16px; line-height: 1.6; }

  .servico__icone-box {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    background: var(--marinho-950);
    color: var(--amarelo);
    border-radius: 3px;
  }
  .card :global(.servico__icone) { color: var(--marinho-800); }

  .servico__modalidades { display: flex; flex-wrap: wrap; gap: 6px; }
  .servico__modalidades li {
    padding: 5px 8px;
    border-radius: 2px;
    background: var(--chip);
    color: var(--marinho-800);
    font-family: var(--fonte-mono);
    font-size: 11px;
    letter-spacing: .04em;
  }
</style>
