  hd: '<path d="M22 13H2"/><path d="M5.5 5.5L2 13v6a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-6l-3.5-7.5A1 1 0 0 0 17.6 5H6.4a1 1 0 0 0-.9.5z"/><line x1="6" y1="16.5" x2="6.01" y2="16.5"/><line x1="10" y1="16.5" x2="10.01" y2="16.5"/>',
